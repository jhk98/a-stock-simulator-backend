#!/usr/bin/env bash
# pre-push — repo-guard: opscore-lint + secretlint. 위반이면 push 차단. (2026-09-19 병주님 정책)
#   규격: metionlabs-claude spec/secrets-sot.md · 검사 본체: metionlabs-opscore/guard.py (형제 repo)
#   ⚠ 각 머신에서 1회: git config core.hooksPath .githooks  (metionlabs-scripts/repo-guard-rollout.py apply-local)
set -e
ROOT="$(git rev-parse --show-toplevel)"
OPS="${OPSCORE:-$ROOT/../metionlabs-opscore}"
if [ ! -f "$OPS/guard.py" ]; then
  echo "🚫 repo-guard: metionlabs-opscore 를 못 찾음 ($OPS). 형제 경로에 clone 하거나 OPSCORE= 지정." >&2
  exit 1
fi
python3 -c "" 2>/dev/null && PY=python3 || PY=python
exec "$PY" "$OPS/guard.py" "$ROOT"
